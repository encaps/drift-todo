# Neon/Vercel Postgres (auto-set when you add Postgres storage in Vercel)
POSTGRES_URL=postgresql://user:pass@host/dbname?sslmode=require

# Web Push (required for notifications)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-public-key
VAPID_PRIVATE_KEY=your-private-key

# Cron secret (set in Vercel dashboard)
CRON_SECRET=your-cron-secret
